{
  "version": 2,
  "functions": {
    "api/index.py": {
      "includeFiles": [
        "smartprint.db"
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/uploads/:path*",
      "destination": "/api/index.py"
    }
  ]
}
